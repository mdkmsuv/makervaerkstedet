[Unit]
Description=Render Makervaerkstedet local workshop templates offline
After=local-fs.target
Before=elevhub-lokal.service elevhub-design.service getty@tty1.service
ConditionPathExists=/usr/share/makervaerkstedet/templates/start.html.j2

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -B /usr/lib/makervaerkstedet/updater/template_activation.py
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
