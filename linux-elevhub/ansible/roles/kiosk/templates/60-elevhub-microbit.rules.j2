ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0d28", ATTR{idProduct}=="0204", OWNER="{{ kiosk_bruger }}", GROUP="root", MODE="0600"
