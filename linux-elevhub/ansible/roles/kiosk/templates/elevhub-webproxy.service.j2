# Styres af Ansible (rollen kiosk).
[Unit]
Description=Elevhub loopback webproxy
After=network-online.target
Wants=network-online.target
Before=elevhub-regler.service

[Service]
Type=simple
User=root
UMask=0077
ExecStartPre=/usr/bin/test -s /etc/elevhub/squid.conf
ExecStartPre=/usr/bin/test -s /etc/elevhub/webproxy-policy.conf
ExecStart=/usr/sbin/squid-openssl -N -f /etc/elevhub/squid.conf
ExecStop=/usr/sbin/squid-openssl -k shutdown -f /etc/elevhub/squid.conf
Restart=no
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
