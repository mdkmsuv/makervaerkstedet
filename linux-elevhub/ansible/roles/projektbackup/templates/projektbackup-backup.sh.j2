#!/bin/sh
set -eu

# Denne fil er root-ejet og må kun ændres af Ansible/root. Alle sikkerheds- og
# mount-kontroller gentages ved hver timer-kørsel, så en afmonteret disk aldrig
# kan få restic til at skrive til en tom mappe på systemdisken.
source={{ projektbackup_kilde | quote }}
repository={{ projektbackup_repository | quote }}
mountpoint={{ projektbackup_mountpoint | quote }}
maaltype={{ projektbackup_maaltype | quote }}
password_file={{ projektbackup_password_file | quote }}

fejl() {
    echo "projektbackup: $*" >&2
    exit 20
}

uden_gruppe_eller_anden_skrivning() {
    mode=$(/usr/bin/stat -c %a -- "$1") || return 1
    group_mode=${mode%?}
    case "$group_mode" in
        *[2367]) return 1 ;;
    esac
    case "$mode" in
        *[2367]) return 1 ;;
    esac
}

root_private() {
    [ "$(/usr/bin/stat -c %u -- "$1")" = 0 ] || return 1
    mode=$(/usr/bin/stat -c %a -- "$1") || return 1
    case "$mode" in
        [0-7]00) ;;
        *) return 1 ;;
    esac
}

root_parentkaede() {
    path=$1
    while [ "$path" != / ]; do
        [ -e "$path" ] || return 1
        root_private_parent=0
        [ "$(/usr/bin/stat -c %u -- "$path")" = 0 ] || return 1
        uden_gruppe_eller_anden_skrivning "$path" || return 1
        path=$(/usr/bin/dirname -- "$path")
    done
}

if [ -L "$source" ]; then
    fejl "projektbackup-kilden er en symlink"
fi
if [ ! -d "$source" ]; then
    echo "projektbackup: projektmappen findes ikke: $source" >&2
    exit 20
fi
source_realpath=$(/usr/bin/realpath -e -- "$source") || fejl "projektmappen kan ikke canonicaliseres"
[ "$source_realpath" = "${source%/}" ] || fejl "projektbackup-kilden er en symlink"
source_owner=$(/usr/bin/stat -c %u -- "$source") || fejl "projektmappens ejer kan ikke læses"
[ "$source_owner" != 0 ] || fejl "projektbackup-kilden må ikke være root-ejet"
uden_gruppe_eller_anden_skrivning "$source" || fejl "projektbackup-kilden er group/other-writable"

if [ "$maaltype" = "mounted" ]; then
    [ -n "$mountpoint" ] || fejl "mountpoint mangler"
    [ ! -L "$mountpoint" ] || fejl "mountpoint er en symlink"
    /usr/bin/mountpoint -q -- "$mountpoint" || fejl "backupdisken er ikke monteret: $mountpoint"
    root_parentkaede "$mountpoint" || fejl "mountpointets parent-kæde er ikke root-ejet og sikker"
fi

root_parentkaede "$(/usr/bin/dirname -- "$password_file")" || fejl "passwordfilens parent-kæde er usikker"
[ -f "$password_file" ] && [ ! -L "$password_file" ] || fejl "password-filen mangler eller er en symlink"
root_private "$password_file" || fejl "password-filen er ikke root-private"

root_parentkaede "$(/usr/bin/dirname -- "$repository")" || fejl "repositoryets parent-kæde er usikker"
[ -d "$repository" ] && [ ! -L "$repository" ] || fejl "restic-repository mangler eller er en symlink"
root_private "$repository" || fejl "restic-repository er ikke root-privat"
[ -f "$repository/config" ] && [ ! -L "$repository/config" ] || fejl "restic-repository er ikke initialiseret"
root_private "$repository/config" || fejl "restic-config er ikke root-privat"

# No exclude is used here: the local project archive, including
# .elevhub/versioner and its SQLite metadata, is part of the backup.
exec /usr/bin/restic \
    --repo "$repository" \
    --password-file "$password_file" \
    --no-cache \
    backup --one-file-system "$source"
