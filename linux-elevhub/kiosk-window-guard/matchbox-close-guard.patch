+Bool
+client_close_blocked(Client *c)
+{
+  Wm *w = c->wm;
+  XClassHint hint;
+  Bool blocked = False;
+
+  if (c->type != MBCLIENT_TYPE_APP || c->trans != NULL
+      || !w->config->block_close_instance
+      || !w->config->block_close_class
+      || !*w->config->block_close_instance
+      || !*w->config->block_close_class)
+    return False;
+
+  memset(&hint, 0, sizeof(hint));
+  if (XGetClassHint(w->dpy, c->window, &hint))
+    {
+      blocked = hint.res_name && hint.res_class
+        && !strcmp(hint.res_name, w->config->block_close_instance)
+        && !strcmp(hint.res_class, w->config->block_close_class);
+      if (hint.res_name) XFree(hint.res_name);
+      if (hint.res_class) XFree(hint.res_class);
+    }
+
+  return blocked;
+}
+
 void
 client_deliver_delete(Client *c)
 {
   Wm *w = c->wm;
+
+  if (client_close_blocked(c))
+    {
+      Atom request = XInternAtom(w->dpy, "_ELEVHUB_FINISH_REQUEST", False);
+      Atom cardinal = XInternAtom(w->dpy, "CARDINAL", False);
+      unsigned long target = c->window;
+      XChangeProperty(w->dpy, w->root, request, cardinal, 32,
+                      PropModeReplace, (unsigned char *)&target, 1);
+      XFlush(w->dpy);
+      dbg("%s() finish requested for protected WM_CLASS\n", __func__);
+      return;
+    }
 
   int   i, n, found = 0;
   Atom *protocols;
